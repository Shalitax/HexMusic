# ╔══════════════════════════════════════════════════════════════╗
# ║  HexMusic — variables de entorno (secretos)                  ║
# ║  Copia este archivo como ".env" y rellena los valores.       ║
# ║  NUNCA subas el archivo .env a git ni lo compartas.          ║
# ╚══════════════════════════════════════════════════════════════╝

# ───── Discord ─────
# Token del bot: https://discord.com/developers/applications → tu app → Bot → Reset Token
DISCORD_TOKEN=pega_aqui_el_token_de_tu_bot

# (Opcional) ID de un servidor de pruebas. Si lo indicas, los comandos slash
# se registran al instante en ese servidor en lugar de globalmente.
DEV_GUILD_ID=

# ───── Lavalink ─────
# Contraseña compartida entre el bot y Lavalink. Usa una larga y aleatoria.
LAVALINK_PASSWORD=cambia_esta_clave_por_una_segura

# Dirección de Lavalink.
#  - Con Docker Compose se fuerza automáticamente a http://lavalink:2333
#  - Sin Docker (Lavalink en tu equipo): http://localhost:2333
LAVALINK_URI=http://localhost:2333

# Memoria máxima para Lavalink (Java). 1G sirve para ~100 reproductores simultáneos.
LAVALINK_MEMORY=1G

# Ruta de la base de datos SQLite (relativa a la carpeta del proyecto)
DATABASE_PATH=data/hexmusic.db

# ───── Fuentes de música (plugin LavaSrc) ─────
# Código de país ISO 3166-1 para catálogos regionales (ES, MX, AR, US...)
MUSIC_COUNTRY_CODE=US

# Spotify → https://developer.spotify.com/dashboard
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music → token de la API de medios (ver docs/FUENTES.md)
APPLEMUSIC_ENABLED=false
APPLEMUSIC_MEDIA_API_TOKEN=

# Deezer (reproducción directa, soporta FLAC con cuenta premium)
DEEZER_ENABLED=false
DEEZER_ARL=
DEEZER_MASTER_KEY=

# Tidal
TIDAL_ENABLED=false
TIDAL_TOKEN=

# Qobuz (reproducción directa en alta fidelidad)
QOBUZ_ENABLED=false
QOBUZ_USER_OAUTH_TOKEN=

# YouTube OAuth (solo si YouTube bloquea la IP de tu servidor, ver docs/FUENTES.md)
YOUTUBE_OAUTH_ENABLED=false

# ───── Panel web (ver docs/PANEL_WEB.md) ─────
WEB_ENABLED=false
WEB_PORT=8080
# Dirección pública del panel. Debe coincidir con el Redirect configurado en Discord.
WEB_PUBLIC_URL=http://localhost:8080
# Portal de desarrolladores → tu app → OAuth2 → Client Secret
WEB_CLIENT_SECRET=
